# Copie para .env e exporte no shell antes de rodar (o servidor nao le .env sozinho)
PORT=3000
HOST=127.0.0.1
# E-mail do Raul: quem se cadastrar com ele vira o unico chefe (permissao total, painel /chefe). Sem verificacao de e-mail ainda: use so em ambiente controlado.
CHEFE_EMAIL=
# Em producao atras de HTTPS: NODE_ENV=production e TRUST_PROXY=1
# Banco (Supabase). Painel > Connect > Transaction pooler (porta 6543). Troque o usuario por app_rw.<ref-do-projeto> e a senha pela que voce definiu para app_rw.
# Na Vercel: Settings > Environment Variables. Nunca use a chave service_role nem o usuario postgres aqui.
DATABASE_URL=postgresql://app_rw.SEU_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# So para o Postgres LOCAL de teste (docs/testes.md): DATABASE_SSL=off. Em producao deixe vazio (a conexao exige SSL).
DATABASE_SSL=
